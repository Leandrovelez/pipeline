          "name": "Login - Sucesso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Token gerado', () => pm.expect(pm.response.json()).to.have.property('authorization'));",
                  "pm.environment.set('token_jwt', pm.response.json().authorization.replace('Bearer ', ''));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
