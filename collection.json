        {
          "name": "Create - Campos Obrigatórios e Proibidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "var res = pm.response.json();",
                  "pm.test('Valida Mensagens de Erro de Contrato', () => {",
                  "    pm.expect(res.nome).to.eql('nome é obrigatório');",
                  "    pm.expect(res.email).to.eql('email é obrigatório');",
                  "    pm.expect(res.password).to.eql('password é obrigatório');",
                  "    pm.expect(res.administrador).to.eql('administrador é obrigatório');",
                  "    pm.expect(res.name).to.eql('name não é permitido');",
                  "    pm.expect(res.login).to.eql('login não é permitido');",
                  "    pm.expect(res.pass).to.eql('pass não é permitido');",
                  "    pm.expect(res.admin).to.eql('admin não é permitido');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
